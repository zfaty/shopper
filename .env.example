# Copy to .env (git-ignored) and fill in the key for the provider you use.
# The server reads .env on start; variables already set in your shell win.

# Which model backend to use; command-line flags override these.
# LLM_PROVIDER: anthropic (default), gemini, groq, openrouter, ollama, openai
LLM_PROVIDER=
LLM_MODEL=
# Only needed for openai, or a non-default host (e.g. Ollama on another machine).
LLM_BASE_URL=
# Example, Ollama on another machine:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2:3b
#   LLM_BASE_URL=http://192.168.1.8:11434/v1

# go run ./cmd/server                       (default, paid API credit)
ANTHROPIC_API_KEY=

# go run ./cmd/server -provider gemini -model gemini-2.5-flash   (free tier)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# go run ./cmd/server -provider groq -model <model>
GROQ_API_KEY=

# go run ./cmd/server -provider openrouter -model <model>:free
OPENROUTER_API_KEY=

# -provider ollama needs no key.
